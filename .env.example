# Opcional localmente. No Cloud Run, use o service account do serviço.
# Não versione o token OAuth. Se usado, informe um caminho absoluto seguro.
INVENTARIO_SPREADSHEET_ID=
INVENTARIO_WORKSHEET=Respostas ao formulário 1
INVENTARIO_RANGE=A:AA
GOOGLE_SHEETS_TOKEN_FILE=C:/caminho-seguro/token_consulta_sheets.json
# No Cloud Run, referencie o Secret Manager nesta variável; não cole o JSON aqui.
GOOGLE_SHEETS_TOKEN_JSON=
